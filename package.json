{
  "name": "sbb-fundbuero",
  "version": "1.0.0",
  "description": "Report something lost on a train while you are still on it, bound to the real journey.",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:tenant",
    "check:tenant": "bash scripts/check-tenant-ssot.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:seed": "tsx scripts/seed.ts",
    "gtfs:import": "tsx scripts/import-gtfs.ts",
    "formations:harvest": "tsx scripts/harvest-formations.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "jest": "^29.7.0",
    "postcss": "^8.4.0",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
