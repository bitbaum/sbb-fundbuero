# Copy to .env.local for development. Every variable here is read by the code;
# nothing is listed that is not (grep `process.env.` to check).

# --- required to run the app ------------------------------------------------

# Postgres. `docker compose up -d` provides one on 5433 for development;
# `pnpm run db:setup` applies the schema and grants.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sbb_fundbuero

# Shared crew secret for every staff route (/api/found-items, /api/events,
# /staff). At least 16 characters; the app refuses staff access (503) when it
# is unset. Not personal authentication — TODO.md carries accounts.
STAFF_ACCESS_TOKEN=

# --- scheduled jobs -----------------------------------------------------------

# Bearer secret the box's systemd timer sends to /api/cron/purge. At least 16
# characters; the route refuses (503) when unset. Generated on the box by the
# operator, never committed.
CRON_SECRET=

# --- optional -----------------------------------------------------------------

# Which operator's identity to build. Defaults to the neutral house brand when
# unset or unknown; `sbb` is an opt-in concept build carrying the
# "unabhängiges Konzept" notice. Inlined at build time. See lib/tenant.ts.
# NEXT_PUBLIC_TENANT=nordbahn

# Public origin, for canonical URLs and the Open Graph image.
# NEXT_PUBLIC_APP_URL=https://nordbahn.orangecat.ch

# Free key from https://api-manager.opentransportdata.swiss/ with the
# Formation Service subscribed. Only `pnpm run formations:harvest` reads it,
# and it refuses to run without one.
# OPENTRANSPORTDATA_API_KEY=
