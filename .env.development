# Local development only. Next loads this file for `next dev` and never for a
# production build, which is the point: these values must not reach a deployed
# bundle. See lib/config.ts for why there is no fallback default anywhere else.
#
# Both variables are deliberately EMPTY right now.
#
# They used to point at http://localhost:3001 and ws://localhost:3003 — the
# reporting and notification services. Those services are gone: this is one
# Next application, so the API will be same-origin route handlers under
# /api and staff push will be a same-origin SSE stream, neither of which
# needs a base URL at all.
#
# Empty means "no backend configured", which turns on demo mode (lib/config.ts)
# and makes the app run on declared fixtures. That is the honest state until
# the route handlers land.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Staff routes fail closed without this. At least 16 characters.
# Local development only — never a real secret in a file that ships.
STAFF_ACCESS_TOKEN=local-dev-staff-token-not-a-secret

# The database. There is deliberately no fallback in code (db/client.ts).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sbb_fundbuero
