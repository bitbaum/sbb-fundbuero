{
  "name": "@sbb-lost-found/reporting-service",
  "version": "1.0.0",
  "description": "Core reporting microservice for lost and found items",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --exec tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@sbb-lost-found/types": "workspace:*",
    "express": "^4.18.0",
    "helmet": "^8.3.0",
    "cors": "^2.8.6",
    "compression": "^1.7.4",
    "morgan": "^1.12.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "joi": "^17.9.0",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "winston": "^3.19.0",
    "socket.io": "^4.8.3",
    "multer": "^2.3.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.0",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/compression": "^1.7.2",
    "@types/morgan": "^1.9.4",
    "@types/pg": "^8.23.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^2.2.0",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/jest": "^30.0.0",
    "typescript": "^6.0.3",
    "tsx": "^4.23.13",
    "nodemon": "^3.1.14",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0"
  }
}
